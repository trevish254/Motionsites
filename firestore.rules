rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && incoming().userId == userId;
      allow update: if isOwner(userId) && incoming().userId == userId && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // User Favorites subcollection
      match /favorites/{promptId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(promptId) && incoming().userId == userId && incoming().promptId is string;
        allow update: if isOwner(userId) && incoming().userId == userId && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // User Custom Prompts subcollection
      match /custom_prompts/{customPromptId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(customPromptId) && incoming().userId == userId && incoming().title is string;
        allow update: if isOwner(userId) && incoming().userId == userId && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }

    // Public Prompt Media (CMS Uploads: Images, GIFs, Videos)
    match /prompt_media/{promptId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}
